# Secrets for docker-compose.yml. Copy to deploy/.env.docker (gitignored) and fill in.

# Public hostname served by Caddy (e.g. ops.example.com). "localhost" for a local trial.
SITE_ADDRESS=localhost

# Strong random password for the bundled PostgreSQL.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# 32 random bytes, base64. Back this up separately from the database: without it,
# stored integration tokens cannot be decrypted.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

DEFAULT_TIMEZONE=Asia/Dubai
