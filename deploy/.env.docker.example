# Secrets and settings for docker-compose.yml. Copy to deploy/.env.docker (gitignored) and fill in.
# Generate random values with:  openssl rand -base64 32

# Public hostname served by Caddy (e.g. ops.example.com). "localhost" for a local trial.
SITE_ADDRESS=localhost

# REQUIRED
POSTGRES_PASSWORD=
# 32 random bytes, base64. Back it up separately from the database: without it, stored integration
# tokens and environment credentials cannot be decrypted.
ENCRYPTION_KEY=

DEFAULT_TIMEZONE=Asia/Dubai

# Report email (SMTP relay; TLS required). Leave SMTP_HOST empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mailbox OAuth apps for supplier follow-ups (see docs/CREDENTIALS.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
INTERNAL_EMAIL_DOMAINS=

# Optional: enables GET /api/metrics for Prometheus (Authorization: Bearer <token>)
METRICS_TOKEN=
