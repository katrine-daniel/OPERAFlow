{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/api/dist/main.js"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@operaflow/web"],
      "env": { "NEXT_TELEMETRY_DISABLED": "1" },
      "port": 3000
    }
  ]
}
