{
  "name": "operaflow",
  "version": "0.1.0",
  "private": true,
  "description": "OPERAFlow - travel operations automation platform (bookings, follow-ups, reports, booking-site testing)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:db": "node scripts/dev-postgres.mjs",
    "db:generate": "npm run generate -w @operaflow/db",
    "db:migrate": "npm run migrate:deploy -w @operaflow/db",
    "db:migrate:dev": "npm run migrate:dev -w @operaflow/db",
    "db:seed": "npm run seed -w @operaflow/db",
    "build": "npm run build -w @operaflow/shared && npm run build -w @operaflow/db && npm run build -w @operaflow/api && npm run build -w @operaflow/web",
    "dev:api": "npm run dev -w @operaflow/api",
    "dev:web": "npm run dev -w @operaflow/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@types/node": "^24.5.2",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "@swc/core@1.16.22": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
