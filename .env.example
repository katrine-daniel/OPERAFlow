# ─────────────────────────────────────────────────────────────────────────────
# OPERAFlow configuration. Copy to `.env` (root) and adjust. Never commit `.env`.
# Every value marked REQUIRED must be set; the API refuses to start otherwise.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Local dev without Docker: `npm run dev:db` starts PostgreSQL on 127.0.0.1:5433
# with these local-only credentials. In Docker/production use your own secret values.
DATABASE_URL=postgresql://operaflow:operaflow_local_dev@127.0.0.1:5433/operaflow
# Separate database used by the API integration tests (it is truncated between tests).
TEST_DATABASE_URL=postgresql://operaflow:operaflow_local_dev@127.0.0.1:5433/operaflow_test

# ── Encryption (REQUIRED) ────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts OAuth refresh tokens and API keys at rest (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored integration tokens unreadable (reconnect required).
ENCRYPTION_KEY=

# ── HTTP / sessions ──────────────────────────────────────────────────────────
API_PORT=4000
# Browser origins allowed to make state-changing requests (CSRF protection). Comma-separated.
WEB_ORIGINS=http://localhost:3000
# Express "trust proxy" setting so client IPs are logged correctly behind the web proxy / load balancer.
TRUST_PROXY=loopback
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# MUST be true in production (HTTPS). The API refuses to start in production otherwise.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Organisation timezone used for "today" on the dashboard and as the report default (IANA name).
DEFAULT_TIMEZONE=Asia/Dubai

# ── Bookings (Phase 2) ───────────────────────────────────────────────────────
# Uploaded booking documents. Must be persistent, backed up, and NOT web-served.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
MAX_IMPORT_ROWS=5000
# Accepted clock skew for signed booking webhooks (replay protection).
WEBHOOK_TOLERANCE_SECONDS=300

# ── Web app ──────────────────────────────────────────────────────────────────
# Where the Next.js server reaches the API (server-side only; never exposed to the browser).
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@operaflow.local
# Leave empty to generate a random password, written to .local/seed-credentials.txt (gitignored).
SEED_ADMIN_PASSWORD=
# true = also create one demo account per role (manager/staff/qa @operaflow.local). Dev only.
SEED_DEMO_USERS=false

# ── Reports & background worker (Phase 3) ────────────────────────────────────
# Public URL of the web app (links in report emails / chat messages).
APP_BASE_URL=http://localhost:3000
# Redis for BullMQ. Without it the worker refuses to start: schedules, follow-ups and scheduled tests do not run
# (manual runs from the UI still work). Docker Compose provides redis://redis:6379.
REDIS_URL=
# Nightly reconciliation (cron, in DEFAULT_TIMEZONE).
RECONCILIATION_CRON=30 5 * * *
REPORT_DELIVERY_MAX_ATTEMPTS=5
# SMTP relay for report emails, e.g. smtp.office365.com:587 (STARTTLS) or smtp-relay.gmail.com:587.
# Leave SMTP_HOST empty to disable email delivery (deliveries are then recorded as FAILED "not configured").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OPERAFlow Reports <reports@yourcompany.com>
# Development only: allow plaintext SMTP (refused in production).
SMTP_ALLOW_INSECURE=false

# ── Mailbox OAuth for supplier follow-ups (Phase 4) ─────────────────────────
# Google Cloud OAuth client (type "Web application"). Redirect URI: <APP_BASE_URL>/api/integrations/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra ID app registration. Redirect URI: <APP_BASE_URL>/api/integrations/oauth/microsoft/callback
MS_OAUTH_TENANT_ID=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# How often tracked threads are checked (minutes, worker).
FOLLOWUP_POLL_MINUTES=10
# Extra company domains treated as internal when classifying replies (the mailbox's own domain always is).
INTERNAL_EMAIL_DOMAINS=

# ── Booking-site tests (Phase 5) ────────────────────────────────────────────
# auto (default) = worker queue when REDIS_URL is set, else inline in the API; "inline" forces in-process runs.
TEST_RUNNER_MODE=auto

# ── Operations (Phase 6) ────────────────────────────────────────────────────
# Enables GET /metrics (Prometheus) for scrapers sending "Authorization: Bearer <token>" (16+ chars).
METRICS_TOKEN=
# Daily purge of expired operational data (periods are set under Settings → Data retention).
RETENTION_CRON=15 3 * * *
# json = one JSON log object per line (always on in production).
LOG_FORMAT=
